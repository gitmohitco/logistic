# ==========================================
# Logistics Control Tower - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=

# Authentication (Google Cloud Platform SSO & OIDC)
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=super-secret-session-key-at-least-32-chars-long

# Mendix 11.12.3 AI & RAG Integration
MENDIX_BASE_URL=https://logistics-ai-sandbox.mendixcloud.com
MENDIX_AI_ENDPOINT=/rest/logistics/v1/exceptions/analyze
MENDIX_TOKEN_URL=https://logistics-ai-sandbox.mendixcloud.com/oauth/v2/token
MENDIX_CLIENT_ID=mendix-control-tower-client
MENDIX_CLIENT_SECRET=mendix-oauth-secret
MENDIX_SCOPE=logistics:exceptions:analyze
MENDIX_AUDIENCE=https://logistics-ai-sandbox.mendixcloud.com

# Webhook Secrets
GPS_WEBHOOK_SECRET=gps-telematics-secure-hmac-secret-key-2026
TMS_WEBHOOK_SECRET=tms-enterprise-secure-hmac-secret-key-2026

# Operational Logging
LOG_LEVEL=info
